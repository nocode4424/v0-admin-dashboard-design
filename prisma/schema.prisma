// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model with role-based access
model User {
  id            String    @id @default(uuid())
  email         String    @unique
  username      String    @unique
  password      String    // Hashed password
  name          String?
  role          UserRole  @default(CUSTOMER)
  restaurantId  String?
  restaurant    Restaurant? @relation(fields: [restaurantId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // Customer-specific fields
  orders        Order[]
  
  // Staff/Manager/Owner access
  locationAccess LocationStaff[]
  
  // Google Business integration
  googleTokens   GoogleTokens?
}

enum UserRole {
  SUPER_ADMIN
  OWNER
  MANAGER
  STAFF
  CUSTOMER
}

// Core restaurant entity
model Restaurant {
  id            String    @id @default(uuid())
  name          String
  description   String?   @db.Text
  logoUrl       String?
  website       String?
  email         String?
  phone         String?
  socialMedia   Json?     // Stores social media links as JSON
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // Relations
  locations     Location[]
  users         User[]
  appearance    AppearanceSettings?
}

// Location entity for multi-location support
model Location {
  id            String    @id @default(uuid())
  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name          String
  address       String
  city          String
  state         String?
  zipCode       String?
  country       String
  phone         String?
  email         String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // Relations
  operatingHours OperatingHours[]
  specialHours   SpecialHours[]
  businessPolicy BusinessPolicy?
  staff          LocationStaff[]
  orders         Order[]
}

// Staff assignment to locations
model LocationStaff {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  locationId  String
  location    Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  
  @@unique([userId, locationId])
}

// Operating hours for locations
model OperatingHours {
  id          String    @id @default(uuid())
  locationId  String
  location    Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  dayOfWeek   Int       // 0 = Sunday, 1 = Monday, etc.
  openTime    String    // Format: HH:MM in 24-hour format
  closeTime   String    // Format: HH:MM in 24-hour format
  isClosed    Boolean   @default(false)
  
  @@unique([locationId, dayOfWeek])
}

// Special hours for holidays, events, etc.
model SpecialHours {
  id          String    @id @default(uuid())
  locationId  String
  location    Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  date        DateTime  @db.Date
  openTime    String?   // Format: HH:MM in 24-hour format
  closeTime   String?   // Format: HH:MM in 24-hour format
  isClosed    Boolean   @default(false)
  description String?
  
  @@unique([locationId, date])
}

// Business policies for each location
model BusinessPolicy {
  id                String    @id @default(uuid())
  locationId        String    @unique
  location          Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  taxRate           Decimal   @default(0) @db.Decimal(5, 2)
  privacyPolicy     String?   @db.Text
  termsOfService    String?   @db.Text
  dataRetentionDays Int       @default(365)
}

// Appearance settings for the restaurant
model AppearanceSettings {
  id              String    @id @default(uuid())
  restaurantId    String    @unique
  restaurant      Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  primaryColor    String    @default("#000000")
  secondaryColor  String    @default("#ffffff")
  accentColor     String    @default("#ff0000")
  backgroundColor String    @default("#f5f5f5")
  cardColor       String    @default("#ffffff")
  textColor       String    @default("#000000")
  buttonStyle     Json      @default("{}")
  headerConfig    Json      @default("{}")
  footerConfig    Json      @default("{}")
  themeName       String    @default("Default")
  isActive        Boolean   @default(true)
}

// Order model for customer orders
model Order {
  id            String    @id @default(uuid())
  customerId    String
  customer      User      @relation(fields: [customerId], references: [id])
  locationId    String
  location      Location  @relation(fields: [locationId], references: [id])
  status        OrderStatus @default(PENDING)
  totalAmount   Decimal   @db.Decimal(10, 2)
  tax           Decimal   @db.Decimal(10, 2)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // Payment and delivery info will be added in later phases
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

// Google Business API integration
model GoogleTokens {
  id            Int       @id @default(autoincrement())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken   String
  refreshToken  String
  expiryDate    DateTime
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}
